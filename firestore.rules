rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public reading of products, categories, bundles, and public settings
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /bundles/{bundleId} {
      allow read: if true;
      allow write: if true;
    }

    match /storeSettings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: customers can submit orders; admin can read and update
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
